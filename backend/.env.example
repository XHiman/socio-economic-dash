# Copy to .env (never commit). In production inject via systemd EnvironmentFile / secrets.
NODE_ENV=development
PORT=3001
# Bind to loopback only; nginx terminates TLS and proxies /api here.
HOST=127.0.0.1
# Number of reverse proxies in front (nginx = 1) so rate limiting sees real client IPs.
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=socioecon
# MUST be a SELECT-only account (see db/prod/create_readonly_user.sql).
DB_USER=dash_ro
DB_PASSWORD=dev_ro_password
DB_SSL=false
# Admin account is only used by `npm run db:seed` in development.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=dev_root_password

RATE_LIMIT_PER_MINUTE=300
